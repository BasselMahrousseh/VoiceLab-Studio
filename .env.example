# ============================================================
# VoiceLab Studio configuration
# Copy to .env in the repo root and fill in your deployment.
# Everything works without the LLM/ASR sections — script
# generation and ASR verification simply stay disabled.
# ============================================================

# --- storage ------------------------------------------------
# DATA_DIR=data
# DATABASE_URL=                       # empty = sqlite in DATA_DIR. e.g. postgresql+psycopg://user:pass@host/db
# Azure App Service production:
# DATA_DIR=/home/data
# STORAGE_BACKEND=azure_blob
# AZURE_STORAGE_ACCOUNT_URL=https://aicognitivesandboxstrg.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=voicelab
# AZURE_CLIENT_ID=<client-id-of-AI-Cognitive-General>

# --- auth ---------------------------------------------------
# Login tokens are HMAC-signed. Leave AUTH_SECRET blank to auto-generate one
# and persist it to data/.auth_secret (fine for a single machine). Set it
# explicitly to share a secret across instances / survive a data reset.
# AUTH_SECRET=
# Seeded admin on first run — change the password from the Team page after login.
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=changeme
# DEFAULT_ADMIN_NAME=Data scientist

# --- LLM for script generation (Azure OpenAI) ----------------
# NOTE: values in this .env file take precedence over any AZURE_OPENAI_* shell
# variables (so a global endpoint from another project can't shadow this one).
# gpt-5.x uses the Responses API; LLM_API_STYLE=auto tries it first, else Chat.
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# Leave blank on App Service to use AZURE_CLIENT_ID / Managed Identity.
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_API_VERSION=2025-04-01-preview
LLM_DEPLOYMENT=gpt-5.6-sol
# LLM_API_STYLE=auto            # auto | responses | chat
# LLM_WORDS_PER_SECOND=2.3      # duration -> sentence-length / hour projections

# For any OpenAI-compatible server instead of Azure:
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://localhost:8001/v1
# OPENAI_API_KEY=...

# --- ASR verification (Whisper deployment) -------------------
# Uses the AZURE_OPENAI_* endpoint/key above unless overridden.
ASR_PROVIDER=azure
ASR_DEPLOYMENT=gpt-4o-transcribe
# Reserved for a future WebSocket/WebRTC transcription path:
# REALTIME_ASR_DEPLOYMENT=gpt-realtime-whisper
# ASR_AZURE_ENDPOINT=
# ASR_AZURE_API_KEY=
# ASR_AZURE_API_VERSION=
# ASR_LANGUAGE=ar

# --- ASR comparison thresholds (CER on normalized text) ------
# ASR_CER_MATCH=0.05
# ASR_CER_MINOR=0.15
# ASR_CER_MATCH_LATIN=0.12
# ASR_CER_MINOR_LATIN=0.30

# --- QC thresholds (defaults are sensible; see backend/app/config.py) ---
# QC_WARN_MIN_DURATION_SEC=2.0
# QC_WARN_MAX_DURATION_SEC=13.0
# QC_SNR_WARN_DB=30
# ROOM_TONE_WARN_DBFS=-55

# --- export ---------------------------------------------------
# EXPORT_SAMPLE_RATE=24000
